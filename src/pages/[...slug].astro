---
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import { BaseCrudService } from "@/integrations";
import type { Articles } from "@/entities";
import { aiEnglishWeaknessArticle as staticArticle } from "@/data/ai-english-weakness-article";
import {
  SITE_NAME,
  AUTHOR_NAME,
  AUTHOR_BIO,
  PAGE_TITLES,
  buildArticleLd,
  buildBreadcrumbLd,
  buildFaqLd,
  buildPersonLd,
  buildWebsiteLd,
  serializeJsonLd,
} from "@/lib/structured-data";
import {
  MIN_FAQ_ITEMS,
  extractFaq,
  formatStoredDate,
  getDateKey,
  getFeaturedArticles,
  getItemPath,
  getLatestArticle,
  getRelatedArticles,
  isArticle,
  isEssay,
  parseArticleBody,
  pickBySlugs,
  sortNewestFirst,
} from "@/lib/articles";
import {
  ABOUT_PROFILE,
  BEST_ARTICLE_SLUGS,
  DEFAULT_OG_IMAGE,
  START_HERE_COUNT,
  START_HERE_SLUGS,
} from "@/config/site";
import "@/styles/global.css";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const segments = path.split("/").filter(Boolean);

// --- Consolidate duplicate/legacy URLs with real HTTP redirects (not client-side JS) ---
if (path === "/blog") {
  return Astro.redirect("/writing", 301);
}
if (path === "/article/ai-exposed-biggest-english-weakness") {
  return Astro.redirect(staticArticle.path, 301);
}

const isHome = path === "/";
const isWriting = path === "/writing";
const isArticleDetail = segments[0] === "writing" && segments.length === 2;
const isEssays = path === "/essays";
const isEssayDetail = segments[0] === "essays" && segments.length === 2;
const isAbout = path === "/about";
const isStaticArticle = path === staticArticle.path;

// --- Server-side data fetch (same helpers as the matching React page) ---
let allItems: Articles[] = [];
let detail: Articles | null = null;
let fetchFailed = false;

try {
  if (isHome || isWriting || isEssays || (isAbout && BEST_ARTICLE_SLUGS.length > 0)) {
    const result = await BaseCrudService.getAll<Articles>("articles", undefined, { limit: 100 });
    allItems = result.items;
  } else if (isArticleDetail || isEssayDetail) {
    const slug = segments[1];
    detail =
      (await BaseCrudService.getByField<Articles>("articles", "slug", slug)) ??
      (await BaseCrudService.getById<Articles>("articles", slug));
    if (detail && isArticle(detail)) {
      const result = await BaseCrudService.getAll<Articles>("articles", undefined, { limit: 100 });
      allItems = result.items;
    }
  }
} catch (error) {
  fetchFailed = true;
  console.error("Error fetching content for", path, error);
}

// An essay requested under /writing (or an article under /essays) moves to its own section.
if (detail && ((isArticleDetail && isEssay(detail)) || (isEssayDetail && !isEssay(detail)))) {
  return Astro.redirect(getItemPath(detail), 301);
}

const articleDetail = isArticleDetail ? detail : null;
const essayDetail = isEssayDetail ? detail : null;
const isKnownRoute =
  isHome || isWriting || isEssays || isAbout || isStaticArticle || Boolean(articleDetail) || Boolean(essayDetail);
const isNotFound = !isKnownRoute;
if (isNotFound) {
  // A failed CMS call is temporary (503); anything else genuinely doesn't exist (404).
  Astro.response.status = fetchFailed ? 503 : 404;
}

const featuredArticles = getFeaturedArticles(allItems, 3);
const latestArticle = getLatestArticle(allItems);
const startHereItems = isHome ? pickBySlugs(allItems, START_HERE_SLUGS.slice(0, START_HERE_COUNT)) : [];
const bestArticles = isAbout ? pickBySlugs(allItems, BEST_ARTICLE_SLUGS.slice(0, 3)).filter(Boolean) : [];
const writingArticles = sortNewestFirst(allItems.filter(isArticle));
const essaysList = sortNewestFirst(allItems.filter(isEssay));
const relatedArticles = articleDetail ? getRelatedArticles(allItems, articleDetail, 3) : [];
const detailItem = articleDetail ?? essayDetail;
const detailBlocks = detailItem ? parseArticleBody(detailItem.mainContent) : [];
const detailFaq = detailItem ? extractFaq(detailItem.mainContent) : [];

// --- Per-route SEO page name + JSON-LD (rendered server-side, always crawlable) ---
// Astro.url.origin can't be trusted here — Vercel's serverless runtime resolves it
// to "https://localhost" instead of the real request host. Astro.site (configured in
// astro.config.mjs from Vercel's own env vars) is the reliable source of truth instead.
const siteUrl = Astro.site ? Astro.site.origin : Astro.url.origin;
// Built from the normalized `path` (no trailing slash, no query string) so /writing,
// /writing/ and /writing?utm_source=x all share one canonical URL.
const canonicalUrl = new URL(path, siteUrl).href;
const DEFAULT_DESCRIPTION =
  'One person\'s real journey using AI to learn faster, write better, and build skills in a second language — documented in public, article by article.';
let pageName = PAGE_TITLES.home;
let metaDescription: string = DEFAULT_DESCRIPTION;
let ogImage: string | undefined;
const jsonLd: Record<string, unknown>[] = [buildWebsiteLd(siteUrl)];
const homeCrumb = { name: "Home", url: siteUrl };

if (isHome) {
  pageName = PAGE_TITLES.home;
} else if (isWriting) {
  pageName = PAGE_TITLES.writing;
  metaDescription = 'Thoughts on AI and analytics. Documenting the journey of continuous learning.';
  jsonLd.push(buildBreadcrumbLd([homeCrumb, { name: "Writing", url: canonicalUrl }]));
} else if (detailItem) {
  const sectionCrumb = articleDetail
    ? { name: "Writing", url: `${siteUrl}/writing` }
    : { name: "Culture Notes", url: `${siteUrl}/essays` };
  pageName = detailItem.articleTitle || `${articleDetail ? "Article" : "Essay"} | ${SITE_NAME}`;
  metaDescription = detailItem.metaDescription || detailItem.shortDescription || DEFAULT_DESCRIPTION;
  jsonLd.push(
    buildArticleLd({
      siteUrl,
      url: canonicalUrl,
      headline: detailItem.articleTitle || pageName,
      description: detailItem.metaDescription || detailItem.shortDescription,
      datePublished: getDateKey(detailItem.publishDate),
      dateModified: getDateKey(detailItem._updatedDate),
      keywords: detailItem.tags,
      articleSection: detailItem.topicCategory,
    })
  );
  if (detailFaq.length >= MIN_FAQ_ITEMS) {
    jsonLd.push(buildFaqLd(detailFaq));
  }
  jsonLd.push(
    buildBreadcrumbLd([homeCrumb, sectionCrumb, { name: detailItem.articleTitle || "Article", url: canonicalUrl }])
  );
} else if (isEssays) {
  pageName = PAGE_TITLES.essays;
  metaDescription = 'Reflective essays on movies and media, viewed through a cultural and ESL lens.';
  jsonLd.push(buildBreadcrumbLd([homeCrumb, { name: "Culture Notes", url: canonicalUrl }]));
} else if (isAbout) {
  pageName = PAGE_TITLES.about;
  metaDescription = ABOUT_PROFILE.shortBio || AUTHOR_BIO;
  jsonLd.push(buildPersonLd(siteUrl));
  jsonLd.push(buildBreadcrumbLd([homeCrumb, { name: "About", url: canonicalUrl }]));
} else if (isStaticArticle) {
  pageName = staticArticle.title;
  metaDescription = staticArticle.metaDescription;
  ogImage = staticArticle.image;
  jsonLd.push(
    buildArticleLd({
      siteUrl,
      url: canonicalUrl,
      headline: staticArticle.title,
      description: staticArticle.metaDescription,
      image: staticArticle.image,
      datePublished: staticArticle.datePublished,
      authorName: staticArticle.author,
      keywords: staticArticle.keywords,
      articleSection: staticArticle.category,
    })
  );
  jsonLd.push(buildFaqLd(staticArticle.faqItems));
  jsonLd.push(
    buildBreadcrumbLd([
      homeCrumb,
      { name: "Writing", url: `${siteUrl}/writing` },
      { name: staticArticle.title, url: canonicalUrl },
    ])
  );
} else if (isNotFound) {
  pageName = PAGE_TITLES.notFound;
  metaDescription = "The page you're looking for doesn't exist.";
  jsonLd.length = 0;
}

const resolvedOgImage = ogImage ?? DEFAULT_OG_IMAGE;
const ogImageUrl = resolvedOgImage ? new URL(resolvedOgImage, siteUrl).href : undefined;
const isArticleType = Boolean(detailItem) || isStaticArticle;
---

<html lang="en" class="w-full h-full">
  <head>
    <Head />
    <title>{pageName}</title>
    <meta name="description" content={metaDescription} />
    {isNotFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={isArticleType ? "article" : "website"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageName} />
    <meta property="og:description" content={metaDescription} />
    {!isNotFound && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {detailItem && getDateKey(detailItem.publishDate) && (
      <meta property="article:published_time" content={getDateKey(detailItem.publishDate)} />
    )}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageName} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {jsonLd.map((entry) => (
      <script type="application/ld+json" set:html={serializeJsonLd(entry)} />
    ))}
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <!--
        Crawlable fallback: the interactive app below mounts with client:only
        (react-router's createBrowserRouter needs a real browser and can't be
        server-rendered), so anything that doesn't execute JavaScript — most
        AI/GEO crawlers included — would otherwise see an empty page. This
        block renders the same content as plain server-rendered HTML. It's
        wrapped in <noscript> so JS-enabled visitors never see it; the React
        app replaces #root's contents on mount either way.
      -->
      <noscript>
        <header>
          <a href="/">{SITE_NAME}</a>
          <nav>
            <a href="/">Home</a>
            <a href="/writing">Writing</a>
            <a href="/essays">Culture Notes</a>
            <a href="/about">About</a>
          </nav>
        </header>

        {isHome && (
          <main>
            <h1>Learning in public. Building with data. Thinking through systems.</h1>
            <p>Exploring AI, analytics, and learning systems while documenting the journey publicly.</p>
            {startHereItems.some(Boolean) && (
              <section>
                <h2>Start Here</h2>
                <ol>
                  {startHereItems.filter(Boolean).map((article) => (
                    <li><a href={getItemPath(article!)}>{article!.articleTitle}</a></li>
                  ))}
                </ol>
              </section>
            )}
            <section>
              <h2>Featured Writing</h2>
              {featuredArticles.length > 0 ? (
                featuredArticles.map((article) => (
                  <article>
                    <h3><a href={getItemPath(article)}>{article.articleTitle}</a></h3>
                    <p><time datetime={getDateKey(article.publishDate)}>{formatStoredDate(article.publishDate)}</time></p>
                    <p>{article.shortDescription}</p>
                  </article>
                ))
              ) : (
                <p>No featured articles yet.</p>
              )}
            </section>
            {latestArticle && (
              <section>
                <h2>Latest Article</h2>
                <article>
                  <h3><a href={getItemPath(latestArticle)}>{latestArticle.articleTitle}</a></h3>
                  <p><time datetime={getDateKey(latestArticle.publishDate)}>{formatStoredDate(latestArticle.publishDate)}</time></p>
                  <p>{latestArticle.shortDescription}</p>
                </article>
              </section>
            )}
          </main>
        )}

        {(isWriting || isEssays) && (
          <main>
            <h1>{isWriting ? "Writing" : "Culture Notes"}</h1>
            <p>{isWriting
              ? "Thoughts on AI and analytics. Documenting the journey of continuous learning."
              : "Reflective essays on movies and media, viewed through a cultural and ESL lens."}</p>
            {(isWriting ? writingArticles : essaysList).length > 0 ? (
              (isWriting ? writingArticles : essaysList).map((article) => (
                <article>
                  <h2><a href={getItemPath(article)}>{article.articleTitle}</a></h2>
                  {article.topicCategory && <p>{article.topicCategory}</p>}
                  <p><time datetime={getDateKey(article.publishDate)}>{formatStoredDate(article.publishDate)}</time></p>
                  <p>{article.shortDescription}</p>
                </article>
              ))
            ) : (
              <p>{isWriting ? "No articles published yet." : "No essays published yet."}</p>
            )}
          </main>
        )}

        {detailItem && (
          <main>
            <article>
              {detailItem.topicCategory && <p>{detailItem.topicCategory}</p>}
              <h1>{detailItem.articleTitle}</h1>
              <p>By {AUTHOR_NAME} — <time datetime={getDateKey(detailItem.publishDate)}>{formatStoredDate(detailItem.publishDate, "long")}</time></p>
              {detailItem.shortDescription && <p>{detailItem.shortDescription}</p>}
              {detailBlocks.map((block) =>
                block.type === "heading" ? (
                  <h2>{block.text}</h2>
                ) : block.type === "paragraph" ? (
                  <p>{block.text}</p>
                ) : (
                  <section>
                    <h2>{block.heading}</h2>
                    {block.items.map((item) => (
                      <div>
                        <h3>{item.question}</h3>
                        <p>{item.answer}</p>
                      </div>
                    ))}
                  </section>
                )
              )}
            </article>
            {relatedArticles.length > 0 && (
              <section>
                <h2>Related articles</h2>
                <ul>
                  {relatedArticles.map((article) => (
                    <li><a href={getItemPath(article)}>{article.articleTitle}</a></li>
                  ))}
                </ul>
              </section>
            )}
          </main>
        )}

        {isNotFound && (
          <main>
            <h1>Page Not Found</h1>
            <p>The page you're looking for doesn't exist.</p>
            <a href="/writing">Back to Writing</a>
          </main>
        )}

        {isAbout && (
          <main>
            <h1>About</h1>
            <p>A student on a long-term journey to build expertise in AI, analytics, and analytical thinking.</p>
            {ABOUT_PROFILE.name && <h2>{ABOUT_PROFILE.name}</h2>}
            {ABOUT_PROFILE.shortBio && <p>{ABOUT_PROFILE.shortBio}</p>}
            {(ABOUT_PROFILE.school || ABOUT_PROFILE.major) && (
              <p>{[ABOUT_PROFILE.major, ABOUT_PROFILE.school].filter(Boolean).join(", ")}</p>
            )}
            {ABOUT_PROFILE.email && <p><a href={`mailto:${ABOUT_PROFILE.email}`}>{ABOUT_PROFILE.email}</a></p>}
            {ABOUT_PROFILE.linkedinUrl && <p><a href={ABOUT_PROFILE.linkedinUrl}>LinkedIn</a></p>}
            <section>
              <h2>The Journey</h2>
              <p>This website exists to document a long-term learning journey. It's not about claiming expertise or selling a product. It's about building skills systematically, thinking deeply, and sharing the process publicly.</p>
              <p>I'm a student focused on developing capabilities in artificial intelligence and data analytics. The goal is to understand these domains deeply, build practical projects, and document insights along the way.</p>
            </section>
            <section>
              <h2>Guiding Principles</h2>
              <ul>
                <li><strong>Learn in Public</strong> — Documenting the journey, sharing insights, and building a body of work that tracks growth over time.</li>
                <li><strong>Build to Understand</strong> — Creating projects and tools to apply theoretical knowledge in practical, real-world scenarios.</li>
                <li><strong>Think Through Systems</strong> — Approaching problems analytically, breaking down complexity, and finding patterns across domains.</li>
                <li><strong>Stay Curious</strong> — Maintaining intellectual curiosity, asking questions, and pursuing understanding beyond surface-level knowledge.</li>
              </ul>
            </section>
            {bestArticles.length > 0 && (
              <section>
                <h2>Best 3 Articles</h2>
                <ul>
                  {bestArticles.map((article) => (
                    <li><a href={getItemPath(article!)}>{article!.articleTitle}</a></li>
                  ))}
                </ul>
              </section>
            )}
          </main>
        )}

        {isStaticArticle && (
          <main>
            <article>
              <p>{staticArticle.category}</p>
              <h1>{staticArticle.title}</h1>
              <p>{staticArticle.subheadline}</p>
              <p>By {staticArticle.author} — <time datetime={staticArticle.datePublished}>{formatStoredDate(staticArticle.datePublished, "long")}</time> — {staticArticle.readingTime}</p>

              {staticArticle.sections.map((section) => (
                <section>
                  <h2>{section.title}</h2>
                  {section.paragraphs.map((paragraph) => (
                    <p set:html={paragraph} />
                  ))}
                  {section.quote && <blockquote>{section.quote}</blockquote>}
                </section>
              ))}

              <section>
                <h2>Frequently Asked Questions</h2>
                {staticArticle.faqItems.map((item) => (
                  <div>
                    <h3>{item.question}</h3>
                    <p>{item.answer}</p>
                  </div>
                ))}
              </section>

              <p>Written by {staticArticle.author}. {staticArticle.authorBio}</p>
            </article>
          </main>
        )}

        <footer>
          <p>&copy; {new Date().getFullYear()} {SITE_NAME}. Documenting the journey of continuous learning in AI and analytics.</p>
        </footer>
      </noscript>
      <AppRouter client:only="react" />
    </div>
  </body>
</html>
